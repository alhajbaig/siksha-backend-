# SIKSHASAATHI BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your genuine credentials

# App Environment
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=https://your-frontend-app.vercel.app
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000,http://127.0.0.1:3000

# Security Key for Session Hashes
JWT_SECRET=your-random-32-byte-secret-key-here

# Groq AI Cloud API (Free high-speed inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_CHATBOT_API_KEY=gsk_your_groq_api_key_here
GROQ_ROADMAP_API_KEY=gsk_your_groq_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Supabase PostgreSQL Cloud Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
SUPABASE_DB_HOST=db.your-project-id.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password
